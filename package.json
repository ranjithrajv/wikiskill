{
  "name": "opencode-wikiskill",
  "version": "0.1.0",
  "description": "WikiSkill: Compiling Agent Experience into Persistent Knowledge for Skill Evolution — OpenCode plugin",
  "bin": {
    "wikiskill": "./dist/cli.mjs"
  },
  "type": "module",
  "files": [
    "dist",
    "src",
    "skills",
    "scripts/postinstall.mjs"
  ],
  "exports": {
    ".": "./src/adapters/opencode/index.ts",
    "./rpc": "./src/adapters/opencode/rpc.ts",
    "./core": "./src/core/index.ts"
  },
  "scripts": {
    "dev": "vp dev",
    "check": "vp check",
    "test": "vp test",
    "build": "vp pack",
    "typecheck": "vp check --typecheck",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "prepack": "vp pack",
    "postinstall": "node ./scripts/postinstall.mjs"
  },
  "dependencies": {
    "@opencode-ai/plugin": "beta"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vite-plus": "^0.3.0"
  }
}
